# Node environment
# Do NOT set NODE_ENV=production yourself on hosts like Render — `next build`/
# `next start` already set it internally, and setting it as a platform env var
# makes `npm install` skip devDependencies (breaking the build, since
# @tailwindcss/postcss, tailwindcss, and typescript are needed at build time).
NEXT_TELEMETRY_DISABLED=1

# Cerebras API (gpt-oss-20b)
# Sign up at https://console.cerebras.ai
CEREBRAS_API_KEY=

# Clerk auth
# Sign up at https://clerk.com — free tier works for Phase 1
# Publishable key MUST use the NEXT_PUBLIC_ prefix — Clerk reads it client-side
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From Clerk Dashboard -> Webhooks -> your endpoint's signing secret (starts with whsec_)
CLERK_WEBHOOK_SECRET=

# Postgres database
# For Render: Postgres is managed in render.yaml; CONNECTION_STRING will be auto-injected
# For other hosts: set DATABASE_URL directly (e.g., postgres://user:pass@host/db)
DATABASE_URL=

# Resend (email)
# Sign up at https://resend.com — free tier works for Phase 1
# Set CONTACT_NOTIFY_EMAIL to the address where lead submissions should arrive
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=

# Background jobs
# Any random long string — must match the same value used as a GitHub Actions
# secret for .github/workflows/process-jobs.yml to call this app's job processor.
INTERNAL_JOB_SECRET=

# Optional: if deploying to Render, these vars will be set in the Render dashboard
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (can be public, no secret needed)
# All other secrets should be added as "Environment Variables" in the Render service settings
